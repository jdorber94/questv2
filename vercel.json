{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/advisor/health",
      "destination": "/api/advisor/health.js"
    },
    {
      "source": "/api/advisor",
      "destination": "/api/advisor/index.js"
    }
  ]
}
