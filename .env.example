# Client-side configuration (Vite only exposes VITE_* vars to the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Override if the advisor API lives on another origin in production
# VITE_ADVISOR_API_URL=https://your-domain.com/api/advisor

# Server-side configuration
GROQ_API_KEY=
ADVISOR_SERVER_PORT=8788
# Comma separated list of allowed origins (leave empty to allow all)
# ADVISOR_ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com
